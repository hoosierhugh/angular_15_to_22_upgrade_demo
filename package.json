{
  "name": "homer-ui",
  "version": "7.8.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 80",
    "dev": "ng serve --configuration=development --port=4200",
    "dev:mock": "ng serve --configuration=mock --host=127.0.0.1 --port=4200 --poll=1000",
    "build:mock": "ng build --configuration=mock",
    "test:mock": "node scripts/test-mock.cjs",
    "webapp": "ng serve --host 0.0.0.0 --configuration=development --port=8099 --disable-host-check",
    "build": "ng build --configuration=production && gzip -9 ./dist/homer-ui/browser/*.js",
    "build-keep-js": "ng build --configuration=production && gzip -9 -k ./dist/homer-ui/browser/*.js",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@fortawesome/angular-fontawesome": "^5.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ng-select/ng-select": "^23.0.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngx-translate/core": "16.0.4",
    "@ngx-translate/http-loader": "16.0.1",
    "ag-charts-angular": "^10.3.9",
    "ag-charts-community": "^10.3.9",
    "ag-grid-angular": "^31.3.1",
    "ag-grid-community": "^31.3.1",
    "angular-gridster2": "^22.0.0",
    "angularx-qrcode": "^22.0.1",
    "autoprefixer": "10.4.5",
    "bootstrap": "^5.3.2",
    "chart.js": "^4.4.1",
    "codejar": "3.7.0",
    "highlight.js": "^11.7.0",
    "html2canvas": "^1.1.4",
    "jwt-decode": "^3.1.2",
    "katex": "^0.16.22",
    "marked": "^18.0.0",
    "marked-katex-extension": "^5.1.12",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.40",
    "ng-dynamic-component": "^11.0.0",
    "ng2-charts": "^5.0.4",
    "ngx-build-plus": "^12.2.0",
    "ngx-codejar": "5.1.3",
    "ngx-json-viewer": "3.2.1",
    "ngx-markdown": "^22.0.2",
    "parsip": "^1.0.6",
    "postcss": "^8.3.6",
    "rxjs": "^7.3.0",
    "swagger-ui-dist": "^4.15.5",
    "ts-md5": "^1.2.9",
    "xlsx": "^0.17.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/language-service": "^22.1.5",
    "@eslint/js": "^10.0.1",
