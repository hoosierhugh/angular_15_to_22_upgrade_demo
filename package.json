{
  "name": "homer-ui",
  "version": "7.8.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 80",
    "dev": "ng serve --configuration=development --port=4200",
    "dev:mock": "ng serve --configuration=mock --host=127.0.0.1 --port=4200 --poll=1000",
    "build:mock": "ng build --configuration=mock",
    "test:mock": "node scripts/test-mock.cjs",
    "webapp": "ng serve --host 0.0.0.0 --configuration=development --port=8099 --disable-host-check",
    "build": "ng build --configuration=production && gzip -9 ./dist/homer-ui/browser/*.js",
    "build-keep-js": "ng build --configuration=production && gzip -9 -k ./dist/homer-ui/browser/*.js",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ng-select/ng-select": "^24.2.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "ag-charts-angular": "^14.2.0",
    "ag-charts-community": "^14.2.0",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "angular-gridster2": "^22.0.0",
    "angularx-qrcode": "^22.0.1",
    "autoprefixer": "10.6.1",
    "bootstrap": "^5.3.2",
    "chart.js": "^4.4.1",
    "codejar": "4.3.0",
    "codejar-linenumbers": "^1.0.1",
    "highlight.js": "^11.7.0",
    "html2canvas": "^1.1.4",
    "jwt-decode": "^4.0.0",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.12",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.5",
    "ng-dynamic-component": "^11.0.0",
    "ng2-charts": "^11.0.0",
    "ngx-codejar": "7.0.3",
    "ngx-json-viewer": "3.2.1",
    "ngx-markdown": "^22.0.2",
    "parsip": "^1.0.6",
    "postcss": "^8.3.6",
    "rxjs": "^7.3.0",
    "swagger-ui-dist": "^5.33.1",
    "ts-md5": "^2.0.1",
    "xlsx": "^0.18.5",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/language-service": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "ts-node": "^10.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3"
