    "karma-coverage": "^2.0.3",
    "karma-jasmine": "^4.0.1",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ts-node": "^10.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
